rules_version = '2';
// Lumen: who may read and write what in Firestore. Paste into Firebase console > Firestore > Rules and publish.
// config/access (admin only): { adminEmails: [...] }, all addresses in lower case.
// billing/<uid>: free days, unlock, payment (see lumen-billing.js). Everyone signs up alone; the app works during the
// free days and while the admin has unlocked the person. config/billing: free days, contact and bank details for signed-in people.
// config/public (readable by anyone, written by admins): topic weights, wish and forwarded error reports for the weekly task.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function email() { return request.auth.token.email.lower(); }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function access() { return get(/databases/$(database)/documents/config/access).data; }
    // Admin rights need a password entry within the last 12 hours, so a forgotten open session or a stolen sign-in expires.
    function recentLogin() { return request.auth.token.auth_time > request.time.toMillis() / 1000 - 43200; }
    function isAdmin() { return verified() && recentLogin() && email() in access().adminEmails; }
    function billingPath() { return /databases/$(database)/documents/billing/$(request.auth.uid); }
    function trialRunning(b) { return b.status == 'trial' && request.time < b.trialStart + duration.value(int(b.trialDays), 'd'); }
    function hasAccess() { return exists(billingPath()) && (get(billingPath()).data.status == 'open' || trialRunning(get(billingPath()).data)); }
    function isMember() { return verified() && (email() in access().adminEmails || hasAccess()); }
    function configuredTrialDays() {
      return exists(/databases/$(database)/documents/config/billing) ? get(/databases/$(database)/documents/config/billing).data.get('trialDays', 3) : 3;
    }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    match /config/public { allow read: if true; allow write: if isAdmin(); }
    match /config/access { allow read, write: if isAdmin(); }
    match /config/billing { allow read: if verified(); allow write: if isAdmin(); }

    match /billing/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      // The free days start once, at the first visit, measured in server time. Only the admin changes anything afterwards.
      allow create: if isAdmin() || (isSelf(uid) && verified()
        && request.resource.data.keys().hasOnly(['status', 'trialStart', 'trialDays'])
        && request.resource.data.status == 'trial' && request.resource.data.trialStart == request.time
        && request.resource.data.trialDays == configuredTrialDays());
      allow update, delete: if isAdmin();
    }

    match /members/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      // The stored address must be the person's own: the admin page acts on it when locking someone.
      allow create, update: if isSelf(uid) && isMember() && request.resource.data.get('email', '').lower() == email();
      allow delete: if isSelf(uid) || isAdmin();
    }
    match /digest/{uid} {
      allow read: if (isSelf(uid) && isMember()) || isAdmin();
      allow create, update: if isSelf(uid) && isMember();
      allow delete: if isSelf(uid) || isAdmin();
    }
    // Friends mode: a small summary per person who opted in, visible to all members.
    match /friends/{uid} {
      allow read: if isMember();
      allow write: if isSelf(uid) && isMember();
      allow delete: if isSelf(uid) || isAdmin();
    }
    // Reminders: the device token and stage times; the reminder job reads them with its own service account.
    match /push/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if isSelf(uid) && isMember();
      allow delete: if isSelf(uid) || isAdmin();
    }
    match /data/users/{uid}/{docId} {
      allow read: if (isSelf(uid) && isMember()) || isAdmin();
      allow create, update: if isSelf(uid) && isMember();
      allow delete: if isSelf(uid) || isAdmin();
    }
  }
}
